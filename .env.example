# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# OpenAI-compatible AI endpoint and key
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_ai_api_key
DS_MODEL=deepseek-v4-flash
GEMINI_MODEL=gemini-3.8-flash
LUNA_MODEL=gpt-6-luna
# --- 图片生成 (AxonHub /v1/images/generations，OpenAI 兼容) ---
# 文生图：POST {AI_BASE_URL}/images/generations
# 图生图：同端点，附 image 字段（base64）
IMAGE_MODEL=gpt-image-2
IMAGE_EDIT_MODEL=gpt-image-2
QWEN_IMAGE_MODEL=qwen-image
# AVScan is a public, undocumented image-search endpoint. It receives the
# source image after local JPEG resizing; no API key is required.
AVSCAN_API_URL=https://avscan.cc/search
AVSCAN_TIMEOUT=90
AVSCAN_MAX_RESULTS=10
# R18.dev is used for `/av 番号` jacket lookup. Requests are direct HTTPS;
# no API key or proxy configuration is used.
R18DEV_TIMEOUT=30
MEMORY_MAX_TURNS=8
MAX_CONCURRENT_UPDATES=8
MEMORY_DB_PATH=/data/memory.db

# Optional: OpenRouter model metadata API key. /context also works without it
# while OpenRouter's public models endpoint is available.
OPENROUTER_API_KEY=
OPENROUTER_CACHE_TTL=3600
MODELS_DEV_CACHE_TTL=3600

# Optional: allowed group/channel ids, comma-separated. Leave empty to allow all.
# Example: -1001234567890,-1002222222222
ALLOWED_GROUP_IDS=

# Optional: allowed public chat usernames, comma-separated (without @)
# Example: Anyincubation,mygroupname
ALLOWED_CHAT_USERNAMES=

# Optional: allowed topic ids in forum groups, comma-separated
# Example: 1,45807
ALLOWED_TOPIC_IDS=

# Optional: topic ids that use civil-safe prompts
# Example: 1

# Optional: auto open/close a specific topic by time window

# --- Codex reset API alert ---
# Codex Reset API monitor. The first successful API poll creates a historical baseline.
CODEX_RESET_ENABLED=1
CODEX_RESET_API_URL=https://codex-resets.com/api/v1/status
CODEX_RESET_POLL_INTERVAL=120
CODEX_RESET_PIN_SECONDS=1800

# Text generation style prompt — leave empty for no system prompt
SYSTEM_PROMPT=