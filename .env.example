# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# OpenAI-compatible AI endpoint and key
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_ai_api_key
DS_MODEL=deepseek-v4-flash
GROK_MODEL=grok-4.5
AI_THINKING_MODEL=deepseek-v4-pro
OAI_MODEL=gpt-5.5
IMAGE_MODEL=gpt-image-2
IMAGE_EDIT_MODEL=gpt-image-2
MEMORY_MAX_TURNS=8
MAX_CONCURRENT_UPDATES=8
MEMORY_DB_PATH=/data/memory.db

# Optional: OpenRouter model metadata API key. /context also works without it
# while OpenRouter's public models endpoint is available.
OPENROUTER_API_KEY=
OPENROUTER_CACHE_TTL=3600
MODELS_DEV_CACHE_TTL=3600

# Optional: allowed group/channel ids, comma-separated. Leave empty to allow all.
# Example: -1001234567890,-1002222222222
ALLOWED_GROUP_IDS=

# Optional: allowed public chat usernames, comma-separated (without @)
# Example: Anyincubation,mygroupname
ALLOWED_CHAT_USERNAMES=

# Optional: allowed topic ids in forum groups, comma-separated
# Example: 1,45807
ALLOWED_TOPIC_IDS=

# Optional: topic ids that use civil-safe prompts
# Example: 1
CIVIL_TOPIC_IDS=

# Optional: auto open/close a specific topic by time window
TIMED_TOPIC_CHAT_ID=
TIMED_TOPIC_ID=45807
TIMED_TOPIC_TZ=Asia/Shanghai
TIMED_OPEN_HOUR=0
TIMED_CLOSE_HOUR=5

# --- 群活跃度：30 天提醒 / 45 天再提醒 / 60 天最后警告后移出 ---
# 仅追踪 bot 见过的成员（发言/入群）。Bot API 无法枚举全员。
# bot 需能看到群消息（建议设为管理员，或关闭隐私模式）；踢人还需 ban 成员权限。
# 全程不修改成员发言权限。超管 /ban 是 soft ban（删消息），/allow 解除；空发 /allow=全解。
INACTIVITY_WARN_ENABLED=1
INACTIVITY_DAYS=30
INACTIVITY_REMIND2_DAYS=45
# 兼容旧名：INACTIVITY_MUTE_DAYS 仍可读，等同 REMIND2
INACTIVITY_KICK_DAYS=60
INACTIVITY_KICK_GRACE_DAYS=3
INACTIVITY_CHECK_INTERVAL=3600
INACTIVITY_MAX_WARNS_PER_CYCLE=10
INACTIVITY_MAX_REMIND2_PER_CYCLE=5
INACTIVITY_MAX_KICK_WARNS_PER_CYCLE=5
INACTIVITY_MAX_KICKS_PER_CYCLE=5
INACTIVITY_WARN_TEXT=你已一个月未发言，请增加活跃度，否则严重会被移出群组。
INACTIVITY_REMIND2_TEXT=你已一个半月未发言，请尽快增加活跃度，否则将被移出群组。
INACTIVITY_KICK_WARN_TEXT=你已经两个月未发言，将在三天后移出群。请尽快发言以保留群籍。
INACTIVITY_KICK_DONE_TEXT=因长期未发言，已移出群组。

# Text generation style prompt — leave empty for no system prompt
SYSTEM_PROMPT=

# --- 视频生成 (agnes-video-v2.0 异步任务 API) ---
# 取结果必须直连上游：AxonHub 会剥掉响应里的视频 url 字段
VIDEO_MODEL=agnes-video-v2.0
VIDEO_BASE_URL=https://apihub.agnes-ai.com
VIDEO_API_KEY=your_agnes_key_here
VIDEO_NUM_FRAMES=81
VIDEO_FRAME_RATE=24
VIDEO_WIDTH=832
VIDEO_HEIGHT=448
